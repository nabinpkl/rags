# Per-project harness config for askRAG. Committed (project config); the briefs
# it renders and the script symlinks are generated + gitignored. Re-run
# `just harness-install` after changing anything here.

# --- Runtime (sourced by the harness scripts) --------------------------------
HARNESS_SESSION="rags"          # tmux prefix-matches the session group rags-0
HARNESS_WINDOW="agents"
HARNESS_WORKTREE_LINKS=".venv backend/.env corpus frontend/node_modules"

# --- Brief rendering (consumed by harness-install.sh) ------------------------
HARNESS_PROJECT="askRAG"
HARNESS_CONTRACT="CLAUDE.md"
HARNESS_SPEC="docs/superpowers/specs/2026-07-04-agentic-rag-design.md"
HARNESS_LEDGER="DECISIONS.md"
HARNESS_BOARD="nabinpkl/rags"
HARNESS_CHECK="just check"
HARNESS_TUNABLES="backend/askrag/config.py"
HARNESS_RULES=".claude/rules/"
