# askRAG deployment settings. Copy to deploy/.env and fill in.
#   cp deploy/.env.example deploy/.env
# Never commit deploy/.env (.dockerignore + .gitignore both exclude it).
#
# Anything absent here falls back to backend/askrag/config.py, which is the
# single home for tunables (§4d). Only deployment-specific values live here.

# --- data ---------------------------------------------------------------
# Host path to the corpus snapshot (D12). corpus.db and models/ mount
# read-only; chroma/ is copied into a container volume on first `just deploy`
# (Chroma writes to its own sqlite on open). pdfs/ is never mounted (§6b).
ASKRAG_CORPUS_HOST_DIR=../corpus

# --- ingress ------------------------------------------------------------
# Caddy publishes on 127.0.0.1 at this port; tailscaled proxies to it.
# Nothing binds a public interface.
ASKRAG_INGRESS_PORT=8420
# Tailnet HTTPS port used by `just deploy-tailnet` (must be free in
# `tailscale serve status`).
ASKRAG_TAILNET_PORT=8443
# Public site (rag.nabin.org): the token of the Cloudflare tunnel whose route
# points at http://web:8080. Set, `just deploy` also starts the tunnel
# container; empty, the stack is tailnet-only. Resources: deploy/README.md.
CLOUDFLARE_TUNNEL_TOKEN=

# --- agent LLM ----------------------------------------------------------
# The agent is off unless this is true: off, POST /api/chat is a 404 and the
# web build hides the panel. Changing it needs a rebuild of web (`just deploy`
# rebuilds both images).
ASKRAG_AGENT_ENABLED=false
# Prod (D3) is Claude Haiku: leave ASKRAG_AGENT_API_BASE_URL empty and set
# ANTHROPIC_API_KEY. The tailnet staging box runs the cheap-first seam
# instead — OpenRouter-routed smoke model, so a private demo costs cents.
# No trailing /v1: the anthropic SDK appends /v1/messages itself.
ASKRAG_AGENT_API_BASE_URL=https://openrouter.ai/api
ASKRAG_SMOKE_MODEL=xiaomi/mimo-v2.6-flash
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- budgets + privacy (D11/§6) ----------------------------------------
# REQUIRED. Salts the per-IP budget key; raw IPs are never stored, and an
# unsalted hash is a rainbow-table lookup away from being an IP again.
# Generate: openssl rand -hex 32
ASKRAG_TRACE_IP_HASH_SALT=
ASKRAG_GLOBAL_DAILY_SPEND_CAP_USD=0.50
ASKRAG_IP_DAILY_SPEND_CAP_USD=0.10

# --- ops ----------------------------------------------------------------
ASKRAG_LOG_LEVEL=INFO
