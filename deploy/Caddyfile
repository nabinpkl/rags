# askRAG ingress (D13). One origin: static export at /, FastAPI under /api.
#
# TLS is deliberately absent here. In the tailnet deployment (issue #81) the
# host's tailscaled terminates HTTPS with a tailnet cert and proxies to this
# port on loopback; in the public one Cloudflare terminates it at the edge and
# a tunnel container carries the request to this listener (compose.yml).

{
	admin off
	auto_https off
	log {
		format json
	}
	# The per-IP budget (D11) needs the visitor's address at the API. Only
	# the hop in front of us may vouch for one, and both fronts sit on the
	# compose subnet: tailscale serve reaches the published loopback port
	# through the bridge gateway (.1) and SETS X-Forwarded-For to the tailnet
	# source; the Cloudflare tunnel container dials web directly and passes
	# on the edge's X-Forwarded-For, which ends with the address Cloudflare
	# saw (anything a client pre-seeded sits to its left). Trusted, Caddy
	# keeps that list and appends the hop, so the API's rightmost-untrusted
	# rule (client_ip.py) lands on the visitor; untrusted, Caddy would
	# replace it with the hop and every visitor would share one cap. The
	# whole subnet, not the tunnel's address: its address is dynamic, only
	# our own services are on this bridge, and the API already trusts the
	# same range (ASKRAG_TRUSTED_PROXY_CIDRS).
	servers {
		trusted_proxies static 10.120.0.0/24
	}
}

# Defined once and imported twice: handle_errors is its own route, so the
# site's directives do not reach it, and a not-found page without these
# headers would be the one HTML response with no CSP.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		-Server

		# connect-src/frame-src name arxiv.org because the viewer's PDF
		# bytes go browser -> arxiv.org DIRECTLY and never through us
		# (D9/§6b); if this policy ever needs a PDF host of our own, that
		# is a compliance bug, not a CSP fix. export.arxiv.org appears
		# nowhere here by D18: no code path may touch it, client-side
		# included. 'unsafe-inline' on scripts is
		# forced by the static export's inline bootstrap — a nonce needs a
		# server that renders HTML, which D13 deliberately does not run.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://arxiv.org; frame-src https://arxiv.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

:8080 {
	encode zstd gzip

	# --- API -------------------------------------------------------------
	handle /api/* {
		# The only request bodies are chat questions, capped far below this
		# by the API (chat_question_max_chars); this stops a large body
		# before it is buffered and parsed.
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# SSE is the whole agent UX (D13): -1 disables response
			# buffering so each event reaches the browser when it is
			# written, not when a buffer fills.
			flush_interval -1
			# No read timeout: an agent turn can think for many seconds
			# between events without the stream being cut.
			transport http {
				read_timeout 0
			}
		}
	}

	# --- paper thumbnails -------------------------------------------------
	# 320px crops of the PDFs we hold, one per paper (D19). Cached as files
	# and rendered on the first request for one: a hit is served straight off
	# disk here, a miss falls through to the api, which renders it, writes it
	# into this same tree, and returns the bytes. Every later request for
	# that paper is a file again.
	#
	# Nothing on this path proxies arxiv.org and no PDF is reachable through
	# it — that is the §6b line, not the size of the image.
	handle_path /thumbs/* {
		root * /srv/thumbs
		@cached file
		handle @cached {
			file_server
			header Cache-Control "public, max-age=604800, immutable"
		}
		handle {
			# No slash before {path}: handle_path has already stripped
			# /thumbs, so {path} still starts with one and spelling
			# another produces /api/thumb//<id>.jpg, which matches no
			# route and 404s every uncached card.
			rewrite * /api/thumb{path}
			reverse_proxy api:8000
		}
	}

	# --- static export ----------------------------------------------------
	handle {
		root * /srv
		# next export writes /foo.html, not /foo/index.html. No /404.html
		# fallback here: that served the not-found page as a 200, so every
		# mistyped or probed path read as a real page to crawlers and the
		# edge cache. A miss falls through to file_server's 404 and
		# handle_errors below renders the page with that status.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		root * /srv
		file_server
		import security_headers
	}

	import security_headers

	# Immutable build assets; everything else stays revalidated so a redeploy
	# is visible without a hard refresh.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
