    "/api/papers/{paper_id}": {
      "get": {
        "summary": "Get Paper",
        "operationId": "get_paper_api_papers__paper_id__get",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paper Id"
