#!/usr/bin/env bash
# Refuse commits on `main` unless the coordinator explicitly authorizes it.
#
# Only the coordinator commits to `main` (the `orchestration:` commits); worker
# agents commit on `issue-<n>` branches inside `.worktrees/`. A worker that
# drifts into the primary checkout and commits to `main` is the failure this
# stops — issue #31 post-mortem: the frontend task landed on `main` twice (once
# recovered by cherry-pick, once caught here). Workers never set the marker, so
# a stray `main` commit is rejected at the source; the coordinator prefixes its
# intentional ones with `ASKRAG_ALLOW_MAIN_COMMIT=1`.
#
# Wired via `git config core.hooksPath scripts/git-hooks` (shared across all
# worktrees). No loops, no network — a single branch check.
set -euo pipefail
branch="$(git symbolic-ref --short -q HEAD || echo DETACHED)"

# Where is this commit happening — the coordinator's PRIMARY checkout, or a
# worker's linked worktree? A linked worktree's git-dir is under
# `<repo>/.git/worktrees/<name>`; the primary checkout's is plain `<repo>/.git`.
case "$(git rev-parse --absolute-git-dir 2>/dev/null)" in
  */worktrees/*) linked_worktree=1 ;;
  *)             linked_worktree=0 ;;
esac

# Workers commit inside their worktrees on issue-<n> branches — always allowed.
# The two things this stops both happen in the PRIMARY checkout:
if [ "$linked_worktree" = 0 ]; then
  # (1) a worker that drifted into the primary checkout and is committing its
  #     issue branch there instead of in .worktrees/<role> (issue #27
  #     post-mortem: the whole build staged onto the primary tree).
  if [ "$branch" != "main" ]; then
    echo "pre-commit: refusing a commit on branch '$branch' in the coordinator's PRIMARY checkout." >&2
    echo "  A worker's issue branch must be committed inside its .worktrees/<role>, not here." >&2
    echo "  If you are a worker: cd into your worktree and commit there." >&2
    exit 1
  fi
  # (2) a stray commit on `main` — only the coordinator's `orchestration:`
  #     commits belong here, and they opt in explicitly.
  if [ "${ASKRAG_ALLOW_MAIN_COMMIT:-}" != "1" ]; then
    echo "pre-commit: refusing a commit on 'main'." >&2
    echo "  Workers commit on issue-<n> branches in .worktrees/, never on main." >&2
    echo "  Coordinator: prefix with ASKRAG_ALLOW_MAIN_COMMIT=1 if this is intentional." >&2
    exit 1
  fi
fi
