# arXiv RAG ingester — recipes. Run `just` to list.
# Override any variable inline, e.g.  just max_gb=8 category=cs.LG seeded-backfill

run      := "uv run"          # uv-managed env (pyproject.toml); auto-syncs on first run
seed     := "../corpus/archive.zip"   # Kaggle arXiv snapshot (.zip)
category := "cs.CL"         # primary-category prefix filter
since    := "2024-01-01"    # backfill start (submission date)
until    := `date -u +%F`   # backfill end (submission date), today by default
max_gb   := "4"             # backfill size budget
conc     := "8"             # parallel GCS downloads
permonth := "3"             # papers per month for the temporal sample
months   := "1"             # newest month folders to check in mirror-status
idmonths := "2607 2608"     # id-months (YYMM) for missing-ids
idsfile  := "../corpus/missing-ids.txt"   # missing-ids output / fetch-ids input

# Friendly alias for the default path
alias backfill := seeded-backfill

# List recipes
default:
    @just --list

# One-time setup: uv-managed environment (deps from pyproject.toml)
setup:
    uv sync

# Newest-first: pull the most recent papers up to the budget. Uses the seed for
# the category filter and the GCS listing for exact sizes, so it hits max_gb
# precisely and downloads only the selected PDFs. Walks backward from today.
#
# Part 1 — most recent papers (newest-first, exact budget)
latest:
    {{run}} arxiv_ingest.py latest \
        --seed-file {{seed}} \
        --category-prefix {{category}} \
        --max-gb {{max_gb}} \
        --concurrency {{conc}}

# Temporal sample: a few papers per month across all years, so the corpus spans
# time and you can see how titles/topics shift -- no embeddings needed.
#
# Part 1 — temporal sample (N per month, all years)
sample:
    {{run}} arxiv_ingest.py sample \
        --seed-file {{seed}} \
        --category-prefix {{category}} \
        --per-month {{permonth}} \
        --concurrency {{conc}}

# Diverse sample: per month, score candidates on five self-contained facets
# (authority, niche, novelty, revisions, venue rigor) and take permonth spread
# across the blended score -- so the corpus spans the impact/topic distribution,
# not just the newest slice. Facets are stored per paper for query-time
# re-ranking. First run downloads + caches the frozen citation file (~172 MB)
# and builds the facet table (~2-3 min); later runs reuse the cache. For CORE
# venue tiers, add --core-file <csv> to the command below.
#
# Part 1 — diverse spread (blended-facet score, all years)
diverse:
    {{run}} arxiv_ingest.py diverse \
        --seed-file {{seed}} \
        --category-prefix cs \
        --per-month {{permonth}} \
        --max-gb {{max_gb}} \
        --concurrency {{conc}}

# Oldest-first over a submission-date window: seed ids from archive.zip, PDFs
# from the GCS mirror. Unthrottled and fast. `until` bounds the far end, which
# is what keeps a month top-up from running on into the months after it.
#
# Part 1 — bulk backfill from a date (Kaggle seed + GCS mirror)
seeded-backfill:
    {{run}} arxiv_ingest.py backfill \
        --seed-file {{seed}} \
        --source gcs \
        --category-prefix {{category}} \
        --date-field submitted \
        --from {{since}} \
        --until {{until}} \
        --max-gb {{max_gb}} \
        --concurrency {{conc}}

# Which cs papers of an id-month is the catalog holding that we are not?
# Listing only. The gap it finds is a unit mismatch: `latest` and
# `seeded-backfill` select by SUBMISSION date, an id's month is its
# ANNOUNCEMENT month, so a paper submitted in June and announced in August is
# outside every August window. Feed the output to `fetch-ids`.
missing-ids:
    {{run}} arxiv_ingest.py missing-ids \
        --months {{idmonths}} \
        --seed-file {{seed}} \
        --category-prefix cs \
        --out {{idsfile}}

# Download a NAMED list of ids (one per line, or a frontier.json manifest).
fetch-ids:
    {{run}} fetch_ids.py {{idsfile}} --concurrency {{conc}}

# Show store stats and the incremental watermark
status:
    {{run}} arxiv_ingest.py status

# Did a new GCS mirror batch land? Bucket listing only, nothing is downloaded.
# The mirror drops in batches every 7-14 days, so this is the signal for when
# `just frontier` + `just index` have new papers to work with.
mirror-status:
    {{run}} arxiv_ingest.py mirror-status --months {{months}}
